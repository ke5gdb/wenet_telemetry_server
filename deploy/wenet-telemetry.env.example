# /etc/wenet-telemetry.env
#
# Read by systemd before the process starts. The app reads these at import, so
# a change needs `systemctl restart wenet-telemetry`, not just a reload.
#
# chown root:wenet, chmod 640 -- it may hold an ingest key.

WENET_DB_PATH=/var/lib/wenet-telemetry/telemetry.db

# Silence longer than this starts a new flight. Raise it if you routinely lose
# the balloon for longer than half an hour; a wrongly split flight is repairable
# with the merge endpoint, but it is nicer not to need it.
WENET_FLIGHT_GAP_MINUTES=30

# How far a sensor packet may reach for a GPS fix when resolving its altitude.
WENET_ALTITUDE_WINDOW_SECONDS=10

# Ingest authentication. Left unset, INGEST IS OPEN: anyone who finds the
# endpoint can insert telemetry that appears on the live display and in exports.
# Set it to require the X-API-KEY header wenet_forwarder already sends, and put
# the same value in the forwarder's WENET_API_KEY.
#   openssl rand -base64 32
#WENET_INGEST_API_KEY=

# Per-IP ingest ceiling. Sized for a forwarder draining a spool after an
# outage, not for steady state. 0 disables.
WENET_RATE_LIMIT_PER_MINUTE=6000

WENET_MAX_BATCH_PACKETS=2000

# --- backups -----------------------------------------------------------------

WENET_BACKUP_DIR=/var/lib/wenet-telemetry/backups
WENET_BACKUP_KEEP=14

# Snapshots on the same disk as the database do not survive losing the VPS.
# Point this at an off-box target to mirror them after each run.
#WENET_BACKUP_RSYNC_TARGET=backup@elsewhere:/srv/wenet-backups
